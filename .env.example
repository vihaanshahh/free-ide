# Secrets only. Hosts, model ids, and the Gravity pixel live in apps/backend/src/config.ts.
# Leave these unset for the canned demo.
# LLM_API_KEY=
# LLM_FALLBACK_API_KEY=
# GRAVITY_API_KEY=

# Optional. Unset is Gravity test mode. Set to 1 for production ads.
# GRAVITY_PRODUCTION=

# GitHub OAuth stub. The callback does not exchange codes in this build.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK=http://127.0.0.1:41824/api/auth/github/callback

SUBSPACES_API_PORT=41824
SUBSPACES_IDE_PORT=41823
SUBSPACES_LANDING_PORT=41825
