# Demo defaults. pnpm dev turns mock mode on if these are unset.
MOCK_LLM=1
MOCK_ADS=1

# Flash model (OpenAI-compatible). Leave blank to stay on the canned provider.
# Every opencode model call goes through this proxy at /v1.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-v4.1-flash

# Gravity. Never commit real values. Test mode unless GRAVITY_PRODUCTION=1.
# GRAVITY_API_KEY=
# GRAVITY_PIXEL_ID=
GRAVITY_PRODUCTION=0

# GitHub OAuth stub. The callback does not exchange codes in this build.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK=http://127.0.0.1:41824/api/auth/github/callback

SUBSPACES_API_PORT=41824
SUBSPACES_IDE_PORT=41823
SUBSPACES_LANDING_PORT=41825

# Landing page build (Vite / Vercel). Not read by the IDE.
# Leave unset to show the waitlist. Set this to the public GitHub Releases download
# base (free bandwidth). Do not point it at Vercel Blob or the private repo.
# VITE_DOWNLOAD_BASE_URL=https://github.com/vihaanshahh/subspaces-releases/releases/latest/download
# VITE_DOWNLOAD_URL is used only when it already ends in /download.
# NEXT_PUBLIC_DOWNLOAD_URL=
# Public editor URL. Loopback values are ignored in a production build.
# VITE_IDE_URL=https://ide.example.com
